{
  "name": "margins",
  "version": "0.1.0",
  "description": "Gamified case-math trainer",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-precache.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:candidates": "vitest run --config vitest.evals.config.ts candidates && cat evals/report/candidates.md",
    "eval:review": "vitest run --config vitest.evals.config.ts candidates.eval && vitest run --config vitest.evals.config.ts review.eval",
    "eval:judge-input": "vitest run --config vitest.evals.config.ts judge-input",
    "admit:candidates": "node scripts/authored/admit.mjs",
    "test:smoke": "playwright test"
  },
  "type": "module",
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/big-shoulders": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "private": true
}
